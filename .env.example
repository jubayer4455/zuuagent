# ==============================================================================
# Zuu Agent — Environment Configuration Example (.env.example)
# NEVER commit raw credentials or real API keys to version control.
# ==============================================================================

# Application & Environment
VITE_APP_ENV=development
VITE_PLATFORM_NAME="Zuu Agent"
VITE_DEFAULT_TIMEZONE="Asia/Dhaka"

# Supabase (Database, Auth & Storage)
# Obtain from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# AI Provider API Keys (Stored server-side or encrypted in secrets_vault)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
OLLAMA_BASE_URL=http://localhost:11434

# Meta Graph API (Facebook Page Publishing)
# Obtain from https://developers.facebook.com
FB_APP_ID=1234567890
FB_APP_SECRET=abcdef...
FB_PAGE_ID=109847291834910
FB_PAGE_ACCESS_TOKEN=EAA...
FB_WEBHOOK_VERIFY_TOKEN=your_secure_random_verify_token

# Platform Security & Encryption
# 32-byte hex key for authenticated server-side secret encryption
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
CRON_SECRET_TOKEN=your_internal_cron_bearer_token
